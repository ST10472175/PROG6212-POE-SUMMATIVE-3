@model List<EventApiDto>
@{ ViewData["Title"] = "Find events"; }
<div class="page-heading"><span class="eyebrow">DISCOVER YOUR NEXT CHALLENGE</span><h1>Find an event</h1><p>Browse upcoming running, walking and cycling events and choose a category when you are ready to enrol.</p></div>
<form method="get" asp-action="Index" class="filter-panel row g-2 align-items-end mb-4">
    <div class="col-lg-5"><label class="form-label" for="search">Search events</label><input id="search" name="search" value="@ViewBag.Search" class="form-control" placeholder="Event name, location or keyword"/></div>
    <div class="col-sm-5 col-lg-3"><label class="form-label" for="eventType">Event type</label><select id="eventType" name="eventType" class="form-select">
        <option value="All" selected="@((string)ViewBag.EventType == "All" ? "selected" : null)">All types</option>
        @foreach (string type in new[] { "Run", "Walk", "Cycle" })
        {
            <option value="@type" selected="@(string.Equals((string)ViewBag.EventType, type, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@type</option>
        }
    </select></div>
    <div class="col-sm-5 col-lg-2"><label class="form-label" for="fromDate">From date</label><input id="fromDate" name="fromDate" type="date" value="@ViewBag.FromDate" class="form-control"/></div>
    <div class="col-sm-2 col-lg-2"><button class="btn btn-accent w-100" type="submit">Filter</button></div>
</form>
@if (Model.Count == 0)
{
    <div class="empty-state"><div class="empty-icon">🔎</div><h3>No matching events</h3><p>Try changing your filters, or check again when organisers publish new events.</p><a asp-action="Index" class="btn btn-outline-primary">Clear filters</a></div>
}
else
{
    <div class="row g-4">
    @foreach (var ev in Model)
    {
        <div class="col-md-6 col-xl-4"><article class="event-card h-100">
            @if (!string.IsNullOrWhiteSpace(ev.BannerImageUrl)) { <img class="event-banner" src="@ev.BannerImageUrl" alt="Banner for @ev.EventName" /> } else { <div class="event-banner banner-placeholder">🏁 <span>RACEDAY EVENT</span></div> }
            <div class="event-card-body"><div class="d-flex justify-content-between align-items-center"><span class="type-pill">@ev.EventType</span><span class="small text-muted">@ev.EventDate.ToString("dd MMM yyyy")</span></div><h3>@ev.EventName</h3><p class="text-muted">@ev.Location · @ev.Distance.ToString("0.##") km</p><p class="event-description">@ev.Description</p><a class="btn btn-accent w-100 mt-2" asp-action="Details" asp-route-id="@ev.EventId">View event and categories</a></div>
        </article></div>
    }
    </div>
}
