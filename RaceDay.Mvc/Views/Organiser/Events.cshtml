@model List<EventApiDto>
@{ ViewData["Title"] = "My events"; }
<div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-3"><div><span class="eyebrow">EVENT MANAGEMENT</span><h1>My events</h1><p>Create, update and manage the events you organise.</p></div><a class="btn btn-accent" asp-action="CreateEvent">＋ Create event</a></div>
@if (Model.Count == 0)
{
    <div class="empty-state"><div class="empty-icon">📅</div><h3>No events have been created</h3><p>Your events will appear here after you create them.</p><a class="btn btn-accent" asp-action="CreateEvent">Create event</a></div>
}
else
{
    <div class="row g-4">
    @foreach (var ev in Model)
    {
        <div class="col-md-6 col-xl-4"><article class="event-card h-100">
            @if (!string.IsNullOrWhiteSpace(ev.BannerImageUrl)) { <img class="event-banner" src="@ev.BannerImageUrl" alt="Banner for @ev.EventName" /> } else { <div class="event-banner banner-placeholder">🏁 <span>RACEDAY EVENT</span></div> }
            <div class="event-card-body"><div class="d-flex justify-content-between align-items-start gap-2"><span class="type-pill">@ev.EventType</span><span class="small text-muted">@ev.EventDate.ToString("dd MMM yyyy")</span></div>
                <h3>@ev.EventName</h3><p class="text-muted">@ev.Location · @ev.Distance.ToString("0.##") km</p><p class="event-description">@ev.Description</p>
                <div class="event-actions"><a asp-action="EditEvent" asp-route-id="@ev.EventId">Edit</a><a asp-action="Categories" asp-route-eventId="@ev.EventId">Categories</a><a asp-action="Enrolments" asp-route-eventId="@ev.EventId">Enrolments</a><a asp-action="Results" asp-route-eventId="@ev.EventId">Results</a></div>
                <form asp-action="DeleteEvent" method="post" class="mt-3" onsubmit="return confirm('Delete this event and its related entries and results?');"><input type="hidden" name="id" value="@ev.EventId" /><button type="submit" class="btn btn-outline-danger btn-sm">Delete event</button></form>
            </div>
        </article></div>
    }
    </div>
}
