@model EventResultsViewModel
@{ ViewData["Title"] = "Event results"; var existingIds = Model.Results.Select(r => r.ParticipantId).ToHashSet(); var eligible = Model.Enrolments.Where(e => !existingIds.Contains(e.ParticipantId)).ToList(); }
<div class="page-heading"><span class="eyebrow">RACE-DAY RESULTS</span><h1>@Model.Event.EventName</h1><p>Capture and correct finish times and finishing positions for enrolled participants.</p></div>
<div class="form-panel mb-4"><h2>Capture a result</h2>
@if (Model.Event.EventDate > DateTime.Now) { <div class="alert alert-info mb-3">Results can be entered after the event has concluded. The event is scheduled for @Model.Event.EventDate.ToString("dd MMM yyyy, HH:mm").</div> }
else if (eligible.Count == 0) { <p class="text-muted mb-0">Every enrolled participant already has a result, or no participants have enrolled.</p> }
else { <form asp-action="CaptureResult" method="post" class="row g-3 align-items-end"><input type="hidden" name="eventId" value="@Model.Event.EventId"/><div class="col-md-5"><label class="form-label" for="NewParticipantId">Participant</label><select name="NewParticipantId" id="NewParticipantId" class="form-select" required><option value="">Choose participant</option>@foreach (var person in eligible) { <option value="@person.ParticipantId">@person.ParticipantName — @person.CategoryName</option> }</select></div><div class="col-md-3"><label class="form-label" for="NewFinishTime">Finish time (hh:mm:ss)</label><input name="NewFinishTime" id="NewFinishTime" class="form-control" placeholder="01:25:30" pattern="[0-9]{2}:[0-9]{2}:[0-9]{2}" required/></div><div class="col-md-2"><label class="form-label" for="NewPositionNumber">Position</label><input name="NewPositionNumber" id="NewPositionNumber" type="number" min="1" value="1" class="form-control" required/></div><div class="col-md-2"><button type="submit" class="btn btn-accent w-100">Record</button></div></form> }
</div>
<div class="content-card"><div class="section-heading"><div><h2>Recorded results</h2><p>@Model.Results.Count participant result(s)</p></div></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Position</th><th>Participant</th><th>Category</th><th>Finish time</th><th>Correct result</th></tr></thead><tbody>
@if (Model.Results.Count == 0) { <tr><td colspan="5" class="text-muted p-4">No results have been recorded for this event yet.</td></tr> }
@foreach (var result in Model.Results.OrderBy(r => r.PositionNumber)) { <tr><td><span class="position-chip">#@result.PositionNumber</span></td><td class="fw-semibold">@result.ParticipantName</td><td>@result.CategoryName</td><td class="font-monospace">@result.FinishTime</td><td><form asp-action="UpdateResult" method="post" class="d-flex gap-2"><input type="hidden" name="eventId" value="@Model.Event.EventId"/><input type="hidden" name="resultsId" value="@result.ResultsId"/><input class="form-control form-control-sm" name="finishTime" value="@result.FinishTime" required pattern="[0-9]{2}:[0-9]{2}:[0-9]{2}" style="max-width:120px"/><input class="form-control form-control-sm" name="positionNumber" type="number" min="1" value="@result.PositionNumber" required style="max-width:78px"/><button class="btn btn-outline-primary btn-sm">Update</button></form></td></tr> }
</tbody></table></div></div><a asp-action="Events" class="text-link d-inline-block mt-3">← Back to my events</a>
