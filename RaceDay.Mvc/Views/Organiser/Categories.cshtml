@model List<CategoryApiDto>
@{ EventApiDto ev = ViewBag.Event as EventApiDto; ViewData["Title"] = "Event categories"; }
<div class="page-heading"><span class="eyebrow">CATEGORY MANAGEMENT</span><h1>@ev?.EventName</h1><p>Add or rename the age and distance categories available for this event.</p></div>
<div class="form-panel mb-4"><h2>Add a category</h2><form asp-action="AddCategory" method="post" class="row g-2 align-items-end"><input type="hidden" name="eventId" value="@ev?.EventId" /><div class="col-md-8"><label class="form-label" for="categoryName">Category name</label><input id="categoryName" name="categoryName" class="form-control" maxlength="100" required placeholder="e.g. Under 20 or 10 km" /></div><div class="col-md-4"><button class="btn btn-accent w-100" type="submit">Add category</button></div></form></div>
<div class="content-card"><div class="section-heading"><div><h2>Available categories</h2><p>@Model.Count category(ies)</p></div></div>
@if (Model.Count == 0) { <p class="p-4 text-muted">No categories have been added yet.</p> }
else { <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Category</th><th>Rename</th><th></th></tr></thead><tbody>@foreach (var category in Model) { <tr><td class="fw-semibold">@category.CategoryName</td><td><form asp-action="RenameCategory" method="post" class="d-flex gap-2"><input type="hidden" name="eventId" value="@category.EventId"/><input type="hidden" name="categoryId" value="@category.CategoryId"/><input name="categoryName" class="form-control form-control-sm" value="@category.CategoryName" maxlength="100" required/><button class="btn btn-outline-primary btn-sm">Save</button></form></td><td><form asp-action="DeleteCategory" method="post"><input type="hidden" name="eventId" value="@category.EventId"/><input type="hidden" name="categoryId" value="@category.CategoryId"/><button class="btn btn-outline-danger btn-sm" type="submit">Delete</button></form></td></tr> }</tbody></table></div> }
</div>
<a asp-action="Events" class="text-link d-inline-block mt-3">← Back to my events</a>
