@model EventFormViewModel
@{ ViewData["Title"] = Model.EventId == 0 ? "Create event" : "Edit event"; bool editing = Model.EventId != 0; }
<div class="page-heading"><span class="eyebrow">EVENT DETAILS</span><h1>@(editing ? "Update event" : "Create an event")</h1><p>Provide the event information participants need before they enrol.</p></div>
<div class="form-panel">
    <form asp-action="@(editing ? "EditEvent" : "CreateEvent")" method="post" enctype="multipart/form-data">
        
        <input asp-for="EventId" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3"><label asp-for="EventName" class="form-label"></label><input asp-for="EventName" class="form-control" /><span asp-validation-for="EventName" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="4"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
        <div class="row g-3"><div class="col-md-6 mb-3"><label asp-for="EventDate" class="form-label"></label><input asp-for="EventDate" type="datetime-local" class="form-control" /><span asp-validation-for="EventDate" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control" /><span asp-validation-for="Location" class="text-danger"></span></div></div>
        <div class="row g-3"><div class="col-md-6 mb-3"><label asp-for="Distance" class="form-label"></label><input asp-for="Distance" class="form-control" type="number" min="0.01" max="1000" step="0.01" /><span asp-validation-for="Distance" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="EventType" class="form-label"></label><select asp-for="EventType" class="form-select"><option>Run</option><option>Walk</option><option>Cycle</option></select><span asp-validation-for="EventType" class="text-danger"></span></div></div>
        @if (!string.IsNullOrWhiteSpace(Model.BannerImageUrl))
        {
            <div class="mb-3"><p class="form-label mb-2">Current event banner</p><img src="@Model.BannerImageUrl" alt="Current banner for @Model.EventName" class="img-fluid rounded" style="max-height: 180px; object-fit: cover;" /></div>
        }
        <div class="mb-4"><label asp-for="BannerImage" class="form-label"></label><input asp-for="BannerImage" type="file" accept="image/png,image/jpeg,image/webp" class="form-control" /><span asp-validation-for="BannerImage" class="text-danger"></span><div class="form-text">The image is uploaded to Azure Blob Storage through the Part 2 API. Leave this empty to keep the current banner.</div></div>
        <div class="d-flex gap-2"><button type="submit" class="btn btn-accent">@(editing ? "Save changes" : "Create event")</button><a asp-action="Events" class="btn btn-outline-secondary">Cancel</a></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
